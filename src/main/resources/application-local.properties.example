# Copy this to application-local.properties and fill in the real values.
# That file is git-ignored so nothing secret ends up on GitHub.
#
#   cp src/main/resources/application-local.properties.example \
#      src/main/resources/application-local.properties

# --- JWT ---
# Any long random string.
app.jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
app.jwt.expiry-hours=24

# --- Gemini ---
# Once there is a key here, switch app.ai.provider to 'gemini'.
app.gemini.api-key=

# --- MySQL for the demo. Leave commented out to keep using H2. ---
#spring.datasource.url=jdbc:mysql://localhost:3306/roadguard
#spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
#spring.datasource.username=root
#spring.datasource.password=
