# Copy to application-local.properties (git-ignored) and fill in real values.
#
#   cp src/main/resources/application-local.properties.example \
#      src/main/resources/application-local.properties

# --- JWT (spec 13) ---
# Any long random string; generate one and keep it out of version control.
app.jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
app.jwt.expiry-hours=24

# --- Gemini Vision (spec 8) ---
# Leave app.ai.provider=stub in application.properties until a key exists.
# With a key: set app.ai.provider=gemini here.
app.gemini.api-key=

# --- MySQL for the demo (spec 18); omit to keep the H2 dev default ---
#spring.datasource.url=jdbc:mysql://localhost:3306/roadguard
#spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
#spring.datasource.username=root
#spring.datasource.password=
